# Copy to .env only if you want to change the defaults. Nothing here is needed for the demo.

# fake (default, offline, free) | openai | anthropic
PROVIDER=fake
# Required for openai/anthropic: a model id from your provider's documentation.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Spending cap in millionths of a US dollar (1000000 = $1.00).
BUDGET_CAP_MICROS=1000000
# Your provider's prices per token, in millionths of a dollar (defaults are illustrative).
PRICE_IN_MICROS=10
PRICE_OUT_MICROS=10

# 1 = never call the provider; jobs return what would have been sent and the worst-case cost.
DRY_RUN=0
