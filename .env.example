# Copy to .env only if you want to change the defaults. Nothing here is needed for the demo.

# fake (default, offline, free) | openai | anthropic
PROVIDER=fake
# Required for openai/anthropic: a model id from your provider's documentation.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Spending cap in millionths of a US dollar (1000000 = $1.00).
BUDGET_CAP_MICROS=1000000
# Your provider's prices per token, in millionths of a dollar (defaults are illustrative).
PRICE_IN_MICROS=10
PRICE_OUT_MICROS=10

# 1 = never call the provider; jobs return what would have been sent and the estimated cost.
DRY_RUN=0

# Client timeout for one provider call, and how long a worker owns a job before
# another worker may take it back. LEASE_SECONDS must be >= 2 * PROVIDER_TIMEOUT + 1.
# Leave empty for the defaults: 1 and 4 for the fake provider, 60 and 121 for
# openai/anthropic (a long reply from a real model can take tens of seconds).
PROVIDER_TIMEOUT=
LEASE_SECONDS=
